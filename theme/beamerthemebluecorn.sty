% beamerthemebluecorn.sty — the Bluecorn presentation theme.
%
% Chassis:  metropolis (must be installed; TeX Live ships it).
% Colors:   Material 3 tonalSpot scheme from seed #174871 "Hopi Blue Corn",
%           generated by theme/tools/m3_palette (Dart, material_color_utilities)
%           into bluecorn-m3-colors.tex — the same algorithm as Flutter's
%           ColorScheme.fromSeed(seedColor: Color(0xFF174871)).
% Fonts:    Roboto (M3 default) + IBM Plex Mono — requires xelatex/lualatex.
% Layout:   light scheme on content frames; dark scheme (Hopi navy
%           primaryContainer) on [standout] frames = title + section dividers.
%
% Usage from a talk directory (e.g. 2026-06_…/deck.tex):
%   % !TEX program = xelatex
%   \makeatletter\def\input@path{{../theme/}}\makeatother
%   \usetheme{bluecorn}
%   …
%   \bluecorntitleframe                    % dark title slide with logo
%   \bluecornsection{What is Zenoh?}{tag}  % dark divider frame
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemebluecorn}[2026/06/06 v1.0 Bluecorn M3 beamer theme]

\usetheme{metropolis}
\metroset{progressbar=frametitle,numbering=fraction,sectionpage=none,block=fill}

% ---------- fonts (xelatex/lualatex) ----------
\RequirePackage{fontspec}
\setsansfont{Roboto}
\setmonofont{IBM Plex Mono}[Scale=MatchLowercase]

% ---------- the generated M3 palette ----------
\input{bluecorn-m3-colors.tex}

% ---------- M3 role mapping: light scheme = content frames ----------
\setbeamercolor{normal text}{fg=m3LightOnSurface, bg=m3LightSurface}
\setbeamercolor{frametitle}{fg=m3LightOnPrimaryContainer, bg=m3LightPrimaryContainer}
\setbeamercolor{progress bar}{fg=m3LightPrimary, bg=m3LightSurfaceVariant}
\setbeamercolor{title separator}{fg=m3LightPrimary, bg=m3LightSurfaceVariant}
\setbeamercolor{progress bar in head/foot}{fg=m3LightPrimary, bg=m3LightSurfaceVariant}
\setbeamercolor{progress bar in section page}{fg=m3LightPrimary, bg=m3LightSurfaceVariant}
\setbeamercolor{structure}{fg=m3LightPrimary}
\setbeamercolor{itemize item}{fg=m3LightPrimary}
\setbeamercolor{itemize subitem}{fg=m3LightPrimary}
\setbeamercolor{enumerate item}{fg=m3LightPrimary}
\setbeamercolor{alerted text}{fg=m3LightTertiary}
\setbeamercolor{example text}{fg=m3LightSecondary}
\setbeamercolor{block title}{fg=m3LightOnSecondaryContainer, bg=m3LightSecondaryContainer}
\setbeamercolor{block body}{fg=m3LightOnSurface, bg=m3LightSurfaceContainerLow}
\setbeamercolor{block title alerted}{fg=m3LightOnTertiaryContainer, bg=m3LightTertiaryContainer}
\setbeamercolor{block title example}{fg=m3LightOnSecondaryContainer, bg=m3LightSecondaryContainer}
\setbeamercolor{footnote}{fg=m3LightOnSurfaceVariant}
\setbeamercolor{page number in head/foot}{fg=m3LightOutline}
\setbeamercolor{caption name}{fg=m3LightPrimary}
\setbeamercolor{button}{fg=m3LightOnPrimary, bg=m3LightPrimary}

% standout frames (title slide + section dividers) = dark scheme, Hopi navy:
% m3DarkPrimaryContainer (#154974) round-trips to ~the seed color itself.
\setbeamercolor{palette primary}{fg=m3DarkOnPrimaryContainer, bg=m3DarkPrimaryContainer}

% hyperlinks
\hypersetup{colorlinks=true, linkcolor=, urlcolor=m3LightPrimary}

% ---------- code listings: M3 surface + syntax roles ----------
\RequirePackage{listings}
\lstdefinestyle{bluecorn}{
  basicstyle=\ttfamily\scriptsize\color{m3LightOnSurface},
  backgroundcolor=\color{m3LightSurfaceContainerHigh},
  keywordstyle=\color{m3LightPrimary}\bfseries,
  commentstyle=\color{m3LightOutline}\itshape,
  stringstyle=\color{m3LightTertiary},
  identifierstyle=\color{m3LightOnSurface},
  numberstyle=\tiny\color{m3LightOutline},
  rulecolor=\color{m3LightOutlineVariant},
  frame=single,
  breaklines=true,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
}
\lstset{style=bluecorn}

% ---------- logo + branded frames ----------
\graphicspath{{../theme/}{./theme/}{../}}
\newcommand{\bluecornlogo}[1][1.5cm]{\includegraphics[height=#1]{bluecorn-logo}}

% Dark title slide: logo, title, accent rule, author, date.
\newcommand{\bluecorntitleframe}{%
  \begin{frame}[standout]
    \bluecornlogo[2.2cm]\par\vspace{1.2em}
    {\usebeamerfont{title}\usebeamercolor[fg]{palette primary}\inserttitle\par}
    \vspace{0.35em}
    {\normalsize\insertsubtitle\par}
    \vspace{0.6em}
    {\color{m3DarkPrimary}\rule{0.3\textwidth}{1.2pt}\par}
    \vspace{0.6em}
    {\small\insertauthor\par}
    \vspace{0.2em}
    {\small\insertdate\par}
  \end{frame}}

% Dark section divider: \bluecornsection{Title}{subtitle line}
\newcommand{\bluecornsection}[2]{%
  \begin{frame}[standout]
    \centering % first token must not be a brace group (beamer reads it as an inline frame title)
    {\usebeamerfont{title}#1\par}
    \vspace{0.5em}
    {\color{m3DarkPrimary}\rule{0.3\textwidth}{1.2pt}\par}
    \vspace{0.5em}
    {\normalsize #2\par}
    \vspace{1.0em}
    \bluecornlogo[1.1cm]\par
  \end{frame}}
